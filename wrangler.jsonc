{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flipkart-axis-cashback",
  "compatibility_date": "2026-08-21",

  // A pure static site: no Worker script, just the Vite build output.
  // SPA handling makes an unknown path serve index.html instead of a 404.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // Request logs in the dashboard. Free to leave on; flip "enabled" to false to stop collecting.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
